# Copy to .env.local and fill in. Nothing else needs provisioning — there is no
# database, so these four values are the entire configuration.

# From the Spotify developer dashboard: https://developer.spotify.com/dashboard
# The app's redirect URIs must include the Auth.js callback, matched exactly:
#   http://127.0.0.1:3434/api/auth/callback/spotify   (pnpm dev)
#   https://<your deployment>/api/auth/callback/spotify
# Spotify rejects `localhost`, so local development uses the loopback IP.
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Any random string. Generate one with: npx auth secret
AUTH_SECRET=

# The origin the browser uses. Required in development, because Next reports
# every request as `localhost` whatever the browser asked for, and Spotify no
# longer accepts `localhost` in a redirect URI. Must match the dashboard entry.
#
# Do not set AUTH_URL as well: Auth.js would then run its own rewrite, which
# under Next 16 does nothing useful and breaks this one.
APP_ORIGIN=http://127.0.0.1:3434

# Which end of a track Spotify's `played_at` marks: 'end' (default) or 'start'.
# Check against a real account with GET /api/diagnostics/played-at before
# trusting automatic advancement — see step 5 of "Deploy your own" in the README.
# PLAYED_AT_SEMANTICS=end
